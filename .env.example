REACT_APP_API_BASE_URL=/api/cash-collection
REACT_APP_REQUEST_TIMEOUT_MS=30000
REACT_APP_USE_MOCKS=false
# Staged rollout only: set in a local, untracked .env.development.local
# (never in the committed .env files — this is a teammate's dev machine).
# REACT_APP_LEGACY_BACKEND_ORIGIN is proxied by src/setupProxy.js (dev
# server only) so the browser's request stays same-origin and avoids CORS;
# point REACT_APP_LEGACY_PENDING_REQUESTS_URL at the proxied /legacy-hbims
# path rather than the raw origin.
REACT_APP_LEGACY_BACKEND_ORIGIN=
REACT_APP_LEGACY_PENDING_REQUESTS_URL=
