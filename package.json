{
  "name": "hbims-cash-collection",
  "version": "1.0.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "antd": "^6.3.4",
    "dayjs": "^1.11.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "prettier": "^3.9.6",
    "react-scripts": "5.0.1",
    "web-vitals": "^5.1.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"contracts/**/*.yaml\" \"docs/**/*.md\" README.md package.json",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"contracts/**/*.yaml\" \"docs/**/*.md\" README.md package.json",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
